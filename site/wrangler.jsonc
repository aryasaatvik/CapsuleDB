{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capsuledb-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "capsuledb.arya.sh",
      "custom_domain": true,
    },
  ],
}
