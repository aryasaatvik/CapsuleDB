{
  "name": "capsuledb-site",
  "private": true,
  "description": "The capsuledb.arya.sh landing page and guides. Not published.",
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync.ts",
    "dev": "bun run sync && blume dev",
    "build": "bun run sync && blume build",
    "check": "bun run sync && blume check",
    "validate": "bun run sync && blume validate --strict",
    "audit": "bun run sync && blume audit --strict",
    "preview": "blume preview",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "blume": "2.2.7",
    "media-chrome": "4.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.8",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.161.0"
  }
}
