{
  "name": "capsuledb",
  "version": "0.1.0",
  "description": "Effect-native private database capsules and migrations",
  "keywords": [
    "database",
    "effect",
    "migrations",
    "sqlite",
    "typescript"
  ],
  "homepage": "https://github.com/aryasaatvik/CapsuleDB#readme",
  "bugs": {
    "url": "https://github.com/aryasaatvik/CapsuleDB/issues"
  },
  "license": "MIT",
  "author": "Arya Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasaatvik/CapsuleDB.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src tests tsdown.config.ts vitest.config.ts vitest.setup.ts oxlint.config.ts",
    "test": "vitest run --exclude tests/artifact/**/*.test.ts",
    "test:artifact": "bun run build && vitest run tests/artifact",
    "test:types": "tstyche --target '>=5.9'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260822.1",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "1.4.0",
    "effect": "4.0.0-rc.112",
    "miniflare": "3.20250718.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsdown": "0.22.14",
    "tstyche": "7.2.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.111 <5"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "bun@1.4.0"
}
